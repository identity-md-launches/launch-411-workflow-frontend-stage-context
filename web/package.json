{
  "name": "lab-per-block-cap-hook-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One-page frontend for the Blockcap (BCAP) launch pool and BlockOutflowCapHook on Sepolia",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "browser:check": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
